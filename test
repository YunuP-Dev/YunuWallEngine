# ==========================================================
# LINUX CORE ENGINE (WATCHDOG RE-LOOP MPV DUAL-MODE)
# ==========================================================
if [ "$1" == "bangkit" ] || [ "$1" == "bangkit_scale" ]; then
    WID_ID="$2"
    TARGET_VIDEO="$3"
    MODE_RAM="$4"
    
    # 🎯 HANTAMAN MATRIKS CERDAS (DETEKSI ASPEK RASIO OTOMATIS)
    if [ "$1" == "bangkit_scale" ]; then
        GET_RES=$("$FFMPEG_PORTABLE" -i "$TARGET_VIDEO" 2>&1 | grep -m 1 "Video:" | grep -o "[0-9]\{3,\}x[0-9]\{3,\}" | head -n 1)
        VID_W=$(echo "$GET_RES" | cut -d'x' -f1)
        VID_H=$(echo "$GET_RES" | cut -d'x' -f2)

        if [[ "$VID_W" =~ ^[0-9]+$ ]] && [[ "$VID_H" =~ ^[0-9]+$ ]]; then
            VAL_W=$(( VID_W * 9 ))
            VAL_H=$(( VID_H * 16 ))
            if [ "$VAL_W" -lt "$VAL_H" ]; then
                SCALE_FLAGS="--video-unscaled=no --keepaspect=no"
            else
                SCALE_FLAGS="--video-unscaled=no --keepaspect=yes --panscan=1.0"
            fi
        else
            SCALE_FLAGS="--video-unscaled=no --keepaspect=yes --panscan=1.0"
        fi
    else
        SCALE_FLAGS="--video-unscaled=no --keepaspect=yes --panscan=0.0"
    fi

    while true; do
        if [ "$MODE_RAM" == "--optim" ]; then
            # [ MODE ENABLED ]: RAM OPTIMIZER (UNIVERSAL COMPATIBILITY - BEBAS CRASH DI VM/PC LAIN)
            # Mencabut paksaan driver i965 dan memberikan kebebasan hwdec auto-safe
            env MALLOC_ARENA_MAX=1 MALLOC_MMAP_THRESHOLD_=4096 G_SLICE=always-malloc vblank_mode=0 ionice -c 3 nice -n 19 \
            "$MPV_PORTABLE" --wid=$WID_ID --loop-file=inf --audio=no --ao=null --vid=1 --no-osc --no-osd-bar --profile=fast --hwdec=auto-safe --cache=no --demuxer-max-bytes=16k --demuxer-max-back-bytes=0 --vd-lavc-fast --vd-lavc-threads=1 --vd-lavc-dr=yes --swapchain-depth=1 --scale=bilinear --cscale=bilinear --dscale=bilinear --interpolation=no $SCALE_FLAGS --load-scripts=no --no-config --input-default-bindings=no --vd-queue-max-bytes=16k --vd-queue-max-samples=1 --vd-queue-max-secs=0 --terminal=no --msg-level=all=no "$TARGET_VIDEO" >/dev/null 2>&1
        else
            # [ MODE DISABLED ]: RUN RUNTIME STANDAR
            "$MPV_PORTABLE" --wid=$WID_ID --loop-file=inf --audio=no --ao=null --no-osc --no-osd-bar --hwdec=auto-safe $SCALE_FLAGS "$TARGET_VIDEO" >/dev/null 2>&1
        fi
        sleep 2
    done
    exit 0
fi
